# NearBin Backend Environment Configuration
# Default port for the Express REST server
PORT=3001

# Node environment (production | development)
NODE_ENV=production

# Database Connection String
# Leave empty to use resilient atomic local JSON file persistence.
# For permanent cloud persistence on Render, Supabase, Neon, or Railway, provide a PostgreSQL URI:
# Example: postgresql://nearbin_user:password@dpg-xxxxx.singapore-postgres.render.com/nearbin_prod?sslmode=require
DATABASE_URL=
