# NearBin Backend Environment Configuration
# Copy this to .env and fill in your values

# Default port for the Express REST server
PORT=3001

# Node environment (production | development)
NODE_ENV=production

# ─── DATABASE (Priority: Firestore > PostgreSQL > JSON file) ─────────────────

# OPTION 1 (Recommended): Firebase Firestore — Permanent cloud DB, never loses data
# Get this from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON as a single-line string (replace newlines with \n)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"nearbin-ba519","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@nearbin-ba519.iam.gserviceaccount.com","client_id":"...","auth_uri":"...","token_uri":"..."}

# OPTION 2: PostgreSQL (Neon / Supabase / Render PostgreSQL)
# DATABASE_URL=postgresql://nearbin_user:password@dpg-xxxxx.singapore-postgres.render.com/nearbin_prod?sslmode=require

# ─── CLOUDINARY (Photo CDN) ──────────────────────────────────────────────────
# Used for photo URL validation on server-side
CLOUDINARY_CLOUD_NAME=dd5rjdc8c
CLOUDINARY_PRESET=nearbin_waste
