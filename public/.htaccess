# NearBin subdomain configuration for Hostinger (nearbin.agriheal.in)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files before applying the SPA route fallback.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Serve privacy policy and terms & conditions directly
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^terms/?$ terms.html [L]

  # Client-side navigation routes load the web app shell.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/manifest+json .json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/vnd.android.package-archive .apk
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
