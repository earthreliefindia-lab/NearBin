# NearBin Apache / LiteSpeed Configuration for Hostinger
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /nearbin/

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Prevent rewrite for existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback all non-file routes to index.html (SPA routing)
  RewriteRule ^ index.html [L]
</IfModule>

# MIME Types for Progressive Web Apps (PWA)
<IfModule mod_mime.c>
  AddType application/manifest+json .json .webmanifest
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Browser Caching for Fast, Glitch-Free Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Service Worker & Manifest: Never aggressively cache to allow instant updates
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/cache-manifest "access plus 0 seconds"
  
  # HTML: Cache for 1 hour
  ExpiresByType text/html "access plus 1 hour"

  # Static Assets (JS, CSS, Images, Fonts): Cache for 1 year
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
