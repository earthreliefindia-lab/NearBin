# NearBin Root Subdomain Configuration for Hostinger (nearbin.agriheal.in)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS on nearbin.agriheal.in
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Never rewrite physical files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback all routes to index.html for Single Page Application (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# MIME Types for Progressive Web Apps (PWA)
<IfModule mod_mime.c>
  AddType application/manifest+json .json .webmanifest
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/vnd.android.package-archive .apk
</IfModule>

# Browser Caching for Instant 60FPS Loading
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Service Worker & Manifest: Never cache to allow instant updates
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/cache-manifest "access plus 0 seconds"
  
  # HTML: Cache for 1 hour
  ExpiresByType text/html "access plus 1 hour"

  # Static Assets (JS, CSS, Images, Fonts, APK): Cache for 1 year
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/vnd.android.package-archive "access plus 1 day"
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
