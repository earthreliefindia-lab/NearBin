# NearBin Subdomain Configuration for Hostinger (nearbin.agriheal.in)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS on nearbin.agriheal.in
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Directly serve physical files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. DO NOT rewrite static assets (JS, CSS, Images, Fonts, APK) to index.html
  # This prevents MIME type ('text/html') errors on script loading
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|json|apk)$ [NC]
  RewriteRule ^ - [L]

  # 4. Fallback only virtual SPA navigation routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Strict MIME Types Configuration for JavaScript and Web Assets
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/javascript .js
  AddType application/manifest+json .json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/vnd.android.package-archive .apk
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Service Worker & Manifest: Never cache to allow instant updates
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/cache-manifest "access plus 0 seconds"
  
  # HTML: Cache for 10 minutes
  ExpiresByType text/html "access plus 10 minutes"

  # Static Assets (JS, CSS, Images, Fonts, APK): Cache for 1 year
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/vnd.android.package-archive "access plus 1 day"
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cross-Origin Resource Sharing (CORS)
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
