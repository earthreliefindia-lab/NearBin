# NearBin Mobile App Environment Configuration
# Production API endpoint used by Expo and the standalone Android APK.
# Note: For public releases, this MUST point to the live HTTPS cloud server (e.g. Render).
EXPO_PUBLIC_API_URL=https://nearbin-api.onrender.com/api

# Optional: Mappls MapmyIndia API Key (Leave empty to use high-res OpenStreetMap & Carto tiles)
EXPO_PUBLIC_MAPPLS_API_KEY=

# Free 10,000 SMS / Month & Google OAuth (Firebase Console ➔ Authentication)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Free Cloud CDN for Camera Images (25GB Free Monthly Storage - Cloudinary)
# Unsigned preset offloads all camera uploads so Hostinger web hosting disk never fills up!
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=earthrelief
EXPO_PUBLIC_CLOUDINARY_PRESET=nearbin_waste
