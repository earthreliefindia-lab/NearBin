# NearBin Mobile App Environment Configuration
# Production API endpoint used by Expo and the standalone Android APK.
# Note: For public releases, this MUST point to the live HTTPS cloud server (e.g. Render).
EXPO_PUBLIC_API_URL=https://nearbin-api.onrender.com/api

# Optional: Mappls MapmyIndia API Key (Leave empty to use high-res OpenStreetMap & Carto tiles)
EXPO_PUBLIC_MAPPLS_API_KEY=
