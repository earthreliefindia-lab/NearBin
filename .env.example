# NearBin Environment Configuration Template
# For production/local development, create a .env file (which is git-ignored)
# and replace "input text" with your actual private credentials.

EXPO_PUBLIC_SUPABASE_URL=input text
EXPO_PUBLIC_SUPABASE_ANON_KEY=input text
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=input text

EXPO_PUBLIC_FIREBASE_API_KEY=input text
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=input text
EXPO_PUBLIC_FIREBASE_PROJECT_ID=input text
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=input text
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=input text
EXPO_PUBLIC_FIREBASE_APP_ID=input text
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=input text

EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=input text
EXPO_PUBLIC_API_URL=input text
EXPO_PUBLIC_MAPPLS_API_KEY=input text

